@model IEnumerable<MyPortfolioMVC.Models.Project>
@{
    ViewData["Title"] = "Table of Contents";
}

<div class="header-section">
    <h1>Project Showcase</h1>
    <p>Exploring 12 unique technical solutions.</p>
</div>

<div class="project-grid">
    @foreach (var project in Model)
    {
        <div class="glass-card project-card">
            <img src="@project.ImageUrl" alt="@project.Title thumbnail" class="project-img" />
            <div class="card-content">
                <h3>@project.Title</h3>
                <p>@project.Description.Substring(0, 60)...</p>
                <div class="card-actions">
                    <a asp-controller="Project" asp-action="Details" asp-route-id="@project.Id" class="btn-primary">View Details</a>
                </div>
            </div>
        </div>
    }
</div>