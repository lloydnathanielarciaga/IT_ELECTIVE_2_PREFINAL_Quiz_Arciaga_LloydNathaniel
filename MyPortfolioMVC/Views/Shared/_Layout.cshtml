<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MyMVCPortfolio</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="glass-nav">
        <div class="nav-container">
            <a class="nav-brand" asp-controller="Portfolio" asp-action="Index">MyMVCPortfolio</a>
            <div class="nav-links">
                <a asp-controller="Portfolio" asp-action="Index">Dashboard</a>
                @if (User.Identity.IsAuthenticated)
                {
                    <span class="admin-badge">Admin Mode</span>
                    <a asp-controller="Auth" asp-action="Logout" class="btn-logout">Logout</a>
                }
                else
                {
                    <a asp-controller="Auth" asp-action="Login" class="btn-login">Login</a>
                }
            </div>
        </div>
    </nav>

    <div class="container main-content">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert-success">@TempData["SuccessMessage"]</div>
        }
        @RenderBody()
    </div>
</body>
</html>