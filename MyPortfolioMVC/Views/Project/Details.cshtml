@model MyPortfolioMVC.Models.Project
@{
    ViewData["Title"] = Model.Title;
    var comments = ViewBag.Comments as List<MyPortfolioMVC.Models.Comment>;
}

<div class="details-container">
    <a asp-controller="Portfolio" asp-action="Index" class="btn-back">← Back to Dashboard</a>

    <div class="glass-card details-hero">
        <img src="@Model.ImageUrl" alt="@Model.Title" class="hero-img" />
        <div class="hero-content">
            <h1>@Model.Title</h1>
            <p class="description">@Model.Description</p>
            <a href="@Model.GitHubLink" target="_blank" class="btn-gradient">View on GitHub</a>
        </div>
    </div>

    <div class="comments-section">
        <h2>Interactive Discussion</h2>

        <div class="glass-card comment-form-card">
            <form asp-action="AddComment" method="post">
                <input type="hidden" name="projectId" value="@Model.Id" />
                <div class="form-group">
                    <input type="text" name="authorName" placeholder="Visitor Name" required class="glass-input" />
                </div>
                <div class="form-group">
                    <textarea name="content" placeholder="Leave your feedback here..." required class="glass-input textarea"></textarea>
                </div>
                <button type="submit" class="btn-primary">Submit Comment</button>
            </form>
        </div>

        <div class="comments-list">
            @if (comments != null && comments.Any())
            {
                foreach (var comment in comments)
                {
                    <div class="glass-card comment-item">
                        <div class="comment-meta">
                            <strong>@comment.AuthorName</strong>
                            <span>@comment.Timestamp.ToString("MMM dd, yyyy HH:mm")</span>
                        </div>
                        <p>@comment.Content</p>
                    </div>
                }
            }
            else
            {
                <p class="no-comments">No comments yet. Be the first to start the discussion!</p>
            }
        </div>
    </div>
</div>