@model MyPortfolioMVC.Models.User
@{
    ViewData["Title"] = "Admin Security";
}

<div class="login-container">
    <div class="glass-card login-card">
        <h2>System Login</h2>
        <p>Restricted area. Please authenticate.</p>

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert-error">@ViewBag.ErrorMessage</div>
        }

        <form asp-action="Login" method="post">
            <div class="form-group">
                <input asp-for="Username" placeholder="Username" required class="glass-input" />
            </div>
            <div class="form-group">
                <input asp-for="Password" type="password" placeholder="Password" required class="glass-input" />
            </div>
            <button type="submit" class="btn-gradient w-100">Authenticate</button>
        </form>
    </div>
</div>